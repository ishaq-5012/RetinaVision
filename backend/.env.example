# CardioVisionAI AI Backend configuration
# Copy to .env and adjust for your environment.
# Run with: uvicorn main:app --reload --port 8000 (from the backend/ directory)

# Port for the FastAPI server (must match VITE_API_URL in the frontend .env)
AI_API_PORT=8000

# Optional: path to a trained EfficientNetB3 weights file.
# When unset, backend/ai_engine/models/efficientnet_model.h5 is used if present.
AI_MODEL_PATH=

# Groq API key for the multimodal (vision) retinal interpretation.
# Backend only - never put this in the frontend .env.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq vision model (must accept image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
